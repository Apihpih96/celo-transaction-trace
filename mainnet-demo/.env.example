# Celo Mainnet USA₮ x402 seller. Never put this file's secrets in browser code or Git.
X402_PAY_TO=0xYourCeloMainnetReceivingAddress
# USA₮ has 6 decimals: 10000 raw units = 0.01 USA₮. Choose deliberately.
X402_PRICE_USAT=10000
# Safe default: paid requests are refused until the operator explicitly enables settlement.
X402_ENABLE_SETTLEMENT=false
# Server-side facilitator key. Not needed for an unpaid 402 check; required to settle.
X402_API_KEY=
PORT=3002
MAINNET_DEMO_URL=http://localhost:3002/decode
