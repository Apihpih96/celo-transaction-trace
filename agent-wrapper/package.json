{
  "name": "celo-transaction-trace-agent-wrapper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.mjs",
    "build:register": "./node_modules/.bin/esbuild src/register-client.js --bundle --format=esm --platform=browser --target=es2022 --outfile=public/register-client.bundle.js",
    "pretest": "npm install --include=dev --no-audit --no-fund && npm run build:register",
    "prestart": "./node_modules/.bin/esbuild src/register-client.js --bundle --format=esm --platform=browser --target=es2022 --outfile=public/register-client.bundle.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@concordium/wallet-connectors": "0.9.0",
    "@concordium/web-sdk": "12.0.3",
    "esbuild": "0.28.2"
  }
}
